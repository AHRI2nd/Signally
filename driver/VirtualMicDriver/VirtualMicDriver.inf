; Signally Virtual Microphone Driver (WaveRT)
; Installs a capture-only audio endpoint visible as a microphone.
; Two KS filters: Topology (mic endpoint) + WaveRT (capture stream).

[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
DriverVer   = 06/03/2026,1.0.0.2
CatalogFile = VirtualMicDriver.cat
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard, NTamd64

[Standard.NTamd64]
%DeviceName% = VirtualMic_Install, Root\VirtualMicDriver

; ── Install ───────────────────────────────────────────────────────────────────
[VirtualMic_Install.NTamd64]
CopyFiles = VirtualMic.CopyFiles

[VirtualMic.CopyFiles]
VirtualMicDriver.sys

[DestinationDirs]
VirtualMic.CopyFiles = 12   ; %SystemRoot%\System32\drivers

[VirtualMic_Install.NTamd64.Services]
AddService = VirtualMicDriver, 0x00000002, VirtualMic.ServiceInstall

[VirtualMic.ServiceInstall]
DisplayName   = %ServiceName%
ServiceType   = 1      ; SERVICE_KERNEL_DRIVER
StartType     = 3      ; SERVICE_DEMAND_START
ErrorControl  = 1      ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\VirtualMicDriver.sys

; ── KS interface registration ────────────────────────────────────────────────
[VirtualMic_Install.NTamd64.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_Wave%,     VirtualMic.I.Wave
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_Wave%,     VirtualMic.I.Wave
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_Wave%,     VirtualMic.I.Wave
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_Topology%, VirtualMic.I.Topo
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_Topology%, VirtualMic.I.Topo

[VirtualMic.I.Wave]
AddReg = VirtualMic.I.Wave.AddReg
[VirtualMic.I.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%Wave.FriendlyName%

[VirtualMic.I.Topo]
AddReg = VirtualMic.I.Topo.AddReg
[VirtualMic.I.Topo.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%MicName%

; ── Source media ──────────────────────────────────────────────────────────────
[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
VirtualMicDriver.sys = 1

[Strings]
ManufacturerName  = "Signally"
DeviceName        = "Signally Virtual Audio Device"
MicName           = "Signally Virtual Microphone"
ServiceName       = "Signally Virtual Microphone Driver"
DiskName          = "Signally Driver Disk"
Wave.FriendlyName = "Signally Virtual Microphone (Wave)"

KSNAME_Wave       = "Wave"
KSNAME_Topology   = "Topology"

; KS proxy + category GUIDs
Proxy.CLSID         = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO    = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_CAPTURE  = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"

; Signally Virtual Microphone Driver
; Installs a WDM capture-only audio endpoint visible as a microphone.

[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
ClassGUID   = {4D36E96C-E325-11CE-BFC1-08002BE10318}
Provider    = %ManufacturerName%
DriverVer   = 06/02/2026,1.0.0.1
CatalogFile = VirtualMicDriver.cat
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard, NTamd64

[Standard.NTamd64]
%DeviceName% = VirtualMic_Install, Root\VirtualMicDriver

[VirtualMic_Install.NTamd64]
Include    = ks.inf, wdmaudio.inf
Needs      = KS.Registration, WDMAUDIO.Registration
CopyFiles  = VirtualMic.CopyFiles
AddReg     = VirtualMic.AddReg

[VirtualMic.CopyFiles]
VirtualMicDriver.sys

[VirtualMic.AddReg]
; Register as audio capture endpoint
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,VirtualMicDriver.sys
HKR,,NTMPDriver,,"VirtualMicDriver.sys,sbemul.sys"
HKR,Drivers,SubClasses,,"wave,midi,aux"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceName%
HKLM,SOFTWARE\Microsoft\Windows NT\CurrentVersion\Drivers32,wave1,,wdmaud.drv

[VirtualMic_Install.NTamd64.Services]
AddService = VirtualMicDriver, 0x00000002, VirtualMic.ServiceInstall

[VirtualMic.ServiceInstall]
DisplayName   = %ServiceName%
ServiceType   = 1      ; SERVICE_KERNEL_DRIVER
StartType     = 3      ; SERVICE_DEMAND_START
ErrorControl  = 1      ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\VirtualMicDriver.sys

[VirtualMic_Install.NTamd64.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,         %KSNAME_Wave%, VirtualMic.Interface
AddInterface = %KSCATEGORY_CAPTURE%,       %KSNAME_Wave%, VirtualMic.Interface
AddInterface = %KSCATEGORY_AUDIO_DEVICE%,  %KSNAME_Wave%, VirtualMic.Interface

[VirtualMic.Interface]
AddReg = VirtualMic.Interface.AddReg

[VirtualMic.Interface.AddReg]
HKR,,FriendlyName,,%MicName%
HKR,,CLSID,,{17CCA71B-ECD7-11D0-B908-00A0C9223196}

[DestinationDirs]
VirtualMic.CopyFiles = 12   ; %SystemRoot%\System32\drivers

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
VirtualMicDriver.sys = 1

[Strings]
ManufacturerName  = "Signally"
DeviceName        = "Signally Virtual Audio Device"
MicName           = "Signally Virtual Microphone"
ServiceName       = "Signally Virtual Microphone Driver"
DiskName          = "Signally Driver Disk"
KSNAME_Wave       = "Wave"
KSCATEGORY_AUDIO  = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_CAPTURE= "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_AUDIO_DEVICE = "{FBF6F530-07B9-11D2-A71E-0000F8004788}"
